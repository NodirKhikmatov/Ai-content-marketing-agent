# Supabase
SUPABASE_URL=https://your-project.supabase.co
# New secret key (recommended): Supabase Dashboard → API → Secret keys
SUPABASE_SECRET_KEY=sb_secret_your-key
# Legacy fallback: service_role JWT (eyJ...). Leave blank when using SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
# Only for legacy HS256 access tokens; modern projects validate via JWKS using SUPABASE_URL.
SUPABASE_JWT_SECRET=

# AI (at least one provider required for analysis pipeline)
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
# Use Gemini for all pipeline steps (recommended when OpenAI/Anthropic are unavailable)
AI_PREFER_GEMINI=false
# Offline dev/testing: return canned responses instead of calling real providers
# (lets the full analysis pipeline run with zero quota usage). Never enable in production.
AI_MOCK_MODE=false

# Analysis defaults (startup mode) — override via API options per request:
# calendar_days=7, competitor_count=4, keyword_count=10, sample_asset_count=3
# Full mode example: calendar_days=30, sample_asset_count=0 (assets for every item)

# AI models (override defaults if a model is retired)
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_MINI=gpt-4o-mini
GEMINI_MODEL=gemini-flash-latest

# Redis / background worker
REDIS_URL=redis://localhost:6379
# true = run analyses through the durable arq worker (requires Redis + worker process).
USE_WORKER_QUEUE=false

# App
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]
